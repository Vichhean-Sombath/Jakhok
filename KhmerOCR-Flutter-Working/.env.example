# Copy to KhmerOCR-Flutter-Working/.env.local for local development.
# Firebase web client settings are safe inside the app bundle, but keep them out of Git.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id
FIREBASE_WEB_APP_ID=your-firebase-web-app-id
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
AUTH_API_BASE_URL=http://127.0.0.1:3000

# Optional mobile values
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=
GOOGLE_SERVER_CLIENT_ID=
