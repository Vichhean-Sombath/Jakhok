# Copy to auth-api/.env.local and fill in real values locally.
# Never commit .env.local or service-account credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_SERVICE_ACCOUNT_JSON=replace-with-full-service-account-json
OTP_HMAC_SECRET=replace-with-random-secret-at-least-32-bytes
RESEND_API_KEY=replace-with-resend-sending-access-key
RESEND_FROM_EMAIL="Netra <no-reply@example.com>"

# Optional local-only settings
LOCAL_AUTH_API_PORT=3000
LOCAL_ADMIN_OTP_BYPASS=0
